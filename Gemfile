source "https://rubygems.org"

# Pins Jekyll and its plugins to the exact versions GitHub Pages uses to build
# this site (https://pages.github.com/versions/), so local previews match production.
gem "github-pages", "~> 232", group: :jekyll_plugins

# Needed by `jekyll serve` on Ruby 3+ (no longer bundled with Ruby).
gem "webrick", "~> 1.8"
